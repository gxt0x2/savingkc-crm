{
  "schemaVersion": 1,
  "policies": {
    "newFileMaxLines": 700,
    "oversizedExistingGrowthToleranceLines": 15,
    "approvedPolling": [
      {
        "path": "src/components/layout/notification-bell.tsx",
        "minimumIntervalMs": 300000,
        "reason": "Refresh the signed-in user's notification count while the CRM is visible. The panel also refreshes on demand when opened."
      }
    ],
    "approvedOversizedSources": [
      {
        "path": "src/app/(app)/dispo/pipeline/page.tsx",
        "maximumLines": 863,
        "owner": "Dispositions",
        "reason": "Existing operations pipeline restored from the prior portal; freeze growth while the workflow is split into owned components.",
        "targetDate": "2026-10-31"
      },
      {
        "path": "src/app/(app)/dispo/tc/page.tsx",
        "maximumLines": 1858,
        "owner": "Transaction Coordination",
        "reason": "Existing transaction coordinator portal restored as one release unit; freeze growth while lanes and panels are extracted.",
        "targetDate": "2026-10-31"
      },
      {
        "path": "src/app/api/marketing/ads-command/route.ts",
        "maximumLines": 1727,
        "owner": "Marketing",
        "reason": "Google Ads read model remains consolidated during the provider recovery; freeze growth while report builders are separated.",
        "targetDate": "2026-10-31"
      },
      {
        "path": "src/app/globals.css",
        "maximumLines": 1105,
        "owner": "Design System",
        "reason": "The current CRM shell and restored operations portals share legacy global tokens; freeze growth while route themes move into scoped layers.",
        "targetDate": "2026-10-31"
      },
      {
        "path": "src/lib/operating-model/communication-template-catalog.ts",
        "maximumLines": 737,
        "owner": "Operations",
        "reason": "The approved acquisitions and dispositions template catalog is kept intact for this release; freeze growth while templates move to data-backed modules.",
        "targetDate": "2026-10-31"
      }
    ],
    "retiredRuntimeRoutes": [
      {
        "path": "src/app/api/auth/setup/route.ts",
        "replacement": "Supabase user administration plus authenticated CRM profile management",
        "reason": "Production code must never contain seeded user credentials."
      },
      {
        "path": "src/app/api/deals/[slug]/test-inspection-report/route.ts",
        "replacement": "deal_pages.inspection_reports and /api/deals/upload",
        "reason": "Buyer-facing deal pages must expose uploaded records, never generated placeholder reports."
      },
      {
        "path": "src/app/api/deploy/route.ts",
        "replacement": "Vercel deployments and GitHub checks",
        "reason": "The local deploy-log polling model is no longer part of the hosted CRM."
      },
      {
        "path": "src/app/api/migrate/route.ts",
        "replacement": "versioned Supabase migrations or authenticated /api/admin/migrate",
        "reason": "Database DDL cannot be exposed through an unauthenticated runtime route."
      },
      {
        "path": "src/app/api/push/test/route.ts",
        "replacement": "a local operations script or authenticated admin diagnostic",
        "reason": "A public test sender must not notify every subscribed agent."
      },
      {
        "path": "src/app/api/setup-twilio/route.ts",
        "replacement": "src/lib/telephony/twiml-app.ts and controlled telephony operations",
        "reason": "A GET request must not create or rewrite shared Twilio infrastructure."
      },
      {
        "path": "src/app/api/setup/manifests/route.ts",
        "replacement": "versioned Supabase migrations",
        "reason": "Migration SQL belongs in source-controlled migrations, not a runtime response."
      }
    ]
  },
