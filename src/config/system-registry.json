{
  "schemaVersion": 1,
  "policies": {
    "newFileMaxLines": 700,
    "oversizedExistingGrowthToleranceLines": 15,
    "approvedPolling": [
      {
        "path": "src/components/layout/notification-bell.tsx",
        "minimumIntervalMs": 300000,
        "reason": "Refresh the signed-in user's notification count while the CRM is visible. The panel also refreshes on demand when opened."
      },
      {
        "path": "src/components/my-day/my-day-workspace.tsx",
        "minimumIntervalMs": 60000,
        "reason": "Keep Casey's active Mission Control metrics and queues current during an operating session."
      },
      {
        "path": "apps/mobile/App.tsx",
        "minimumIntervalMs": 3000000,
        "reason": "Refresh the Twilio Voice token and device registration every 50 minutes while the mobile app is active."
      },
      {
        "path": "src/components/telephony/telephony-bar.tsx",
        "minimumIntervalMs": 1000,
        "reason": "Update the visible in-call elapsed-time counter once per second; this timer does not poll the network."
      },
      {
        "path": "src/app/(public)/ppc/SellLanding.tsx",
        "minimumIntervalMs": 2000,
        "reason": "Read the active embedded testimonial player's local progress every two seconds only while it is playing so 25, 50, and 75 percent analytics fire once; this does not poll the CRM or a network API.",
        "targetDate": "2026-11-30"
      },
      {
        "path": "src/components/telephony/use-dialer-post-call-review.ts",
        "minimumIntervalMs": 3000,
        "reason": "Poll only while a just-ended durable Dialer attempt is awaiting provider transcription, stop on terminal state, and cap the wait at 20 requests so disposition never blocks on AI.",
        "targetDate": "2026-11-30"
      },
      {
        "path": "src/app/(app)/conversations/page.tsx",
        "minimumIntervalMs": 15000,
        "reason": "Refresh the authoritative inbox head, selected-thread state and queue membership, and active timeline while the CRM is visible so inbound communications appear without client-authored unread state. Response row counts stay capped regardless of loaded history.",
        "targetDate": "2026-11-30"
      },
      {
        "path": "src/components/prospecting/prospecting-workspace.tsx",
        "minimumIntervalMs": 15000,
        "reason": "Refresh only the selected active campaign detail while the Prospecting command center is visible so server-owned delivery, reply, failure, suppression, and dialer progress stay current without polling every campaign or loaded history.",
        "targetDate": "2026-11-30"
      }
    ],
