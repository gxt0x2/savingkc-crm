    "retiredRuntimeRoutes": [
      {
        "path": "src/app/api/auth/setup/route.ts",
        "replacement": "Supabase user administration plus authenticated CRM profile management",
        "reason": "Production code must never contain seeded user credentials."
      },
      {
        "path": "src/app/api/deals/[slug]/test-inspection-report/route.ts",
        "replacement": "deal_pages.inspection_reports and /api/deals/upload",
        "reason": "Buyer-facing deal pages must expose uploaded records, never generated placeholder reports."
      },
      {
        "path": "src/app/api/deploy/route.ts",
        "replacement": "Vercel deployments and GitHub checks",
        "reason": "The local deploy-log polling model is no longer part of the hosted CRM."
      },
      {
        "path": "src/app/api/migrate/route.ts",
        "replacement": "versioned Supabase migrations and reviewed operations scripts",
        "reason": "Database DDL cannot be exposed through an unauthenticated runtime route."
      },
      {
        "path": "src/app/api/admin/migrate/route.ts",
        "replacement": "versioned Supabase migrations and the authenticated system-config API",
        "reason": "Hosted bootstrap checks and legacy configuration seeding do not belong in a production request handler."
      },
      {
        "path": "src/app/api/admin/fix-orphans/route.ts",
        "replacement": "the canonical Mojo ingestion pipeline and a reviewed offline reconciliation operation",
        "reason": "A GET request must not create seller records, and the only remaining orphan is quarantined synthetic test residue rather than a recoverable seller."
      },
      {
        "path": "src/app/api/admin/migrate-deals/route.ts",
        "replacement": "versioned Supabase migrations",
        "reason": "Production already has the complete deal_pages schema, so runtime DDL is unnecessary."
      },
      {
        "path": "src/app/api/admin/repair-mojo-leads/route.ts",
        "replacement": "the normal Mojo ingestion pipeline and a reviewed operations script if historical repair is ever required",
        "reason": "Production has no remaining placeholder Mojo leads, so the one-time mutating repair handler is complete."
      },
      {
        "path": "src/app/api/push/test/route.ts",
        "replacement": "a local operations script or authenticated admin diagnostic",
        "reason": "A public test sender must not notify every subscribed agent."
      },
      {
        "path": "src/app/api/setup-twilio/route.ts",
        "replacement": "src/lib/telephony/twiml-app.ts and controlled telephony operations",
        "reason": "A GET request must not create or rewrite shared Twilio infrastructure."
      },
      {
        "path": "src/app/api/setup/manifests/route.ts",
        "replacement": "versioned Supabase migrations",
        "reason": "Migration SQL belongs in source-controlled migrations, not a runtime response."
      }
    ]
  },
