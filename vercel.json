{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/sweep-briefings",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/sync-gmail",
      "schedule": "15 13 * * *"
    },
    {
      "path": "/api/hot-opportunities/cron",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/workers/ppc-conversion-export",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/google-ads-reporting-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/openai-ads-reporting-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/google-ads-missed-calls",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-mojo-queue",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/sync-mojo-emails",
      "schedule": "*/15 13-22 * * 1-5"
    },
    {
      "path": "/api/admin/mojo-health",
      "schedule": "*/15 13-22 * * 1-5"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
